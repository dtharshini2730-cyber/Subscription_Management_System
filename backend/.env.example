# Copy to .env and replace placeholders before running the backend.

APP_NAME="SUBSENSE API"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Replace with a securely generated random value.
SECRET_KEY="replace-with-a-random-secret-before-use"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite for local development; configure your database URL as needed.
DATABASE_URL="sqlite:///./subsense.db"

CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

ADMIN_DEFAULT_EMAIL="admin@example.com"
ADMIN_DEFAULT_PASSWORD="replace-with-a-strong-password"
ADMIN_DEFAULT_NAME="System Administrator"
